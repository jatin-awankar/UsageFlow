generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  password    String?
  image       String?
  createdAt   DateTime     @default(now())
  auditLogs   AuditLog[]
  memberships Membership[]
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  createdAt           DateTime             @default(now())
  aggregatedUsages    AggregatedUsage[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  invoices            Invoice[]
  memberships         Membership[]
  metrics             Metric[]
  plans               Plan[]
  subscriptions       Subscription[]
  usageEvents         UsageEvent[]
  webhookEndpoints    WebhookEndpoint[]
  webhookEvents       WebhookEvent[]
  organizationInvites OrganizationInvite[]
}

model Membership {
  id        String       @id @default(uuid())
  role      Role
  userId    String
  orgId     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model ApiKey {
  id          String       @id @default(uuid())
  name        String
  hashedKey   String       @unique
  active      Boolean      @default(true)
  lastUsedAt  DateTime?
  orgId       String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]
}

model Metric {
  id          String       @id @default(uuid())
  name        String
  key         String
  unit        String
  description String?
  orgId       String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planMetrics PlanMetric[]
  usageEvents UsageEvent[]

  @@unique([orgId, key])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  basePrice     Int
  billingPeriod BillingPeriod
  orgId         String
  createdAt     DateTime       @default(now())
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planMetrics   PlanMetric[]
  subscriptions Subscription[]
}

model PlanMetric {
  id            String   @id @default(uuid())
  includedUnits Int
  pricePerUnit  Int
  planId        String
  metricId      String
  createdAt     DateTime @default(now())
  metric        Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metricId])
}

model Subscription {
  id                 String             @id @default(uuid())
  status             SubscriptionStatus
  periodStart        DateTime
  periodEnd          DateTime?
  orgId              String
  planId             String
  externalCustomerId String?
  aggregatedUsages   AggregatedUsage[]
  invoices           Invoice[]
  org                Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  usageEvents        UsageEvent[]
}

model UsageEvent {
  id             String   @id @default(uuid())
  metricKey      String
  amount         Int
  customerId     String?
  metadata       Json?
  timestamp      DateTime @default(now())
  orgId          String
  subscriptionId String
  apiKeyId       String
  idempotencyKey String?  @unique
  metricId       String?
  createdAt      DateTime @default(now())
  metric         Metric?  @relation(fields: [metricId], references: [id], onDelete: SetNull)

  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([orgId, subscriptionId, metricKey, timestamp])
  @@index([idempotencyKey])
}

model AggregatedUsage {
  id             String       @id @default(uuid())
  metricKey      String
  total          Int
  periodStart    DateTime
  periodEnd      DateTime
  orgId          String
  subscriptionId String
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([orgId, subscriptionId, metricKey, periodStart])
  @@index([orgId, subscriptionId])
  @@index([orgId, metricKey])
}

model Invoice {
  id             String        @id @default(uuid())
  amount         Int
  status         InvoiceStatus
  periodStart    DateTime
  periodEnd      DateTime
  orgId          String
  subscriptionId String
  createdAt      DateTime      @default(now())
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lineItems      Json?

  @@index([orgId, createdAt])
  @@index([subscriptionId])
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  url       String
  secret    String
  active    Boolean      @default(true)
  events    String[]
  orgId     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  webhookDeliveries WebhookDelivery[]
}

model AuditLog {
  id        String       @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  orgId     String
  userId    String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}

model WebhookEvent {
  id           String             @id @default(uuid())
  type         String
  payload      Json
  status       WebhookEventStatus @default(PENDING)
  orgId        String
  createdAt    DateTime           @default(now())
  deliveries   WebhookDelivery[]
  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookEventId String
  endpointId     String
  status         WebhookDeliveryStatus @default(PENDING)
  responseCode   Int?
  responseBody   String?
  attempt        Int                   @default(1)
  durationMs     Int?
  createdAt      DateTime              @default(now())

  webhookEvent WebhookEvent    @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEventId, endpointId, attempt])
}

model OrganizationInvite {
  id        String   @id @default(uuid())
  orgId     String
  email     String
  role      Role
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAUSED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}
