generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  password    String?
  image       String?
  createdAt   DateTime     @default(now())
  auditLogs   AuditLog[]
  memberships Membership[]
  priceVersions PriceVersion[]
  pricingGapCorrections PricingGapCorrection[]
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  currency            String?              @db.VarChar(3)
  createdAt           DateTime             @default(now())
  aggregatedUsages    AggregatedUsage[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  invoices            Invoice[]
  memberships         Membership[]
  metrics             Metric[]
  plans               Plan[]
  subscriptions       Subscription[]
  usageEvents         UsageEvent[]
  webhookEndpoints    WebhookEndpoint[]
  webhookEvents       WebhookEvent[]
  organizationInvites OrganizationInvite[]
  customers           Customer[]
  ledgerExports       LedgerExport[]
  priceVersions       PriceVersion[]
  ratedEvents         RatedEvent[]
  ratingFailures      RatingFailure[]
  unratedEvents        UnratedEvent[]
  pricingGapCorrections PricingGapCorrection[]
  billingRecords BillingRecord[]
}

model Customer {
  id         String       @id @default(uuid())
  orgId      String
  externalId String
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  usageEvents UsageEvent[]
  ratedEvents RatedEvent[]
  unratedEvents UnratedEvent[]
  pricingGapCorrections PricingGapCorrection[]
  billingRecords BillingRecord[]

  @@unique([orgId, externalId])
  @@unique([orgId, id])
}

model Membership {
  id        String       @id @default(uuid())
  role      Role
  userId    String
  orgId     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model ApiKey {
  id          String       @id @default(uuid())
  name        String
  hashedKey   String       @unique
  active      Boolean      @default(true)
  lastUsedAt  DateTime?
  orgId       String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]
}

model Metric {
  id          String       @id @default(uuid())
  name        String
  key         String
  unit        String
  description String?
  orgId       String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planMetrics PlanMetric[]
  usageEvents UsageEvent[]
  priceVersions PriceVersion[]
  pricingGapCorrections PricingGapCorrection[]

  @@unique([orgId, key])
  @@unique([orgId, id])
}

model PriceVersion {
  id String @id @default(uuid())
  orgId String
  metricId String
  currency String @db.VarChar(3)
  unitPriceMicros BigInt
  effectiveFrom DateTime @db.Timestamptz(3)
  createdById String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  metric Metric @relation(fields: [orgId, metricId], references: [orgId, id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  ratedEvents RatedEvent[]
  ratingFailures RatingFailure[]

  @@unique([orgId, metricId, effectiveFrom])
  @@unique([id, orgId, metricId])
  @@unique([id, orgId, metricId, currency, unitPriceMicros])
  @@index([orgId, metricId, effectiveFrom])
}

model RatedEvent {
  eventId String @id
  orgId String
  billedCustomerId String
  metricId String
  priceVersionId String?
  correctionId String?
  quantity Int
  unitPriceMicros BigInt
  amount Decimal @db.Decimal(18, 3)
  currency String @db.VarChar(3)
  ratedAt DateTime @default(now()) @db.Timestamptz(3)
  event UsageEvent @relation(fields: [eventId, orgId, billedCustomerId, metricId, quantity], references: [id, orgId, billedCustomerId, metricId, amount], onDelete: Restrict)
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [orgId, billedCustomerId], references: [orgId, id], onDelete: Restrict)
  priceVersion PriceVersion? @relation(fields: [priceVersionId, orgId, metricId, currency, unitPriceMicros], references: [id, orgId, metricId, currency, unitPriceMicros], onDelete: Restrict)
  correction PricingGapCorrection? @relation(fields: [correctionId], references: [id], onDelete: Restrict)

  @@index([orgId, billedCustomerId])
  @@unique([eventId, orgId, billedCustomerId, metricId, quantity])
}

model PricingGapCorrection {
  id String @id @default(uuid())
  orgId String
  metricId String
  billedCustomerId String
  start DateTime @db.Timestamptz(3)
  end DateTime @db.Timestamptz(3)
  currency String @db.VarChar(3)
  unitPriceMicros BigInt
  reviewedAt DateTime @db.Timestamptz(3)
  approvedAt DateTime @default(now()) @db.Timestamptz(3)
  approvedById String
  reason String
  evidence String
  affectedEventIds String[]
  resultingRatingIds String[]
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [orgId, billedCustomerId], references: [orgId, id], onDelete: Restrict)
  metric Metric @relation(fields: [orgId, metricId], references: [orgId, id], onDelete: Restrict)
  approvedBy User @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  ratings RatedEvent[]
}

model UnratedEvent {
  eventId String @id
  orgId String
  billedCustomerId String
  metricId String
  reason String @db.VarChar(32)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  event UsageEvent @relation(fields: [eventId, orgId, billedCustomerId, metricId], references: [id, orgId, billedCustomerId, metricId], onDelete: Restrict)
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [orgId, billedCustomerId], references: [orgId, id], onDelete: Restrict)

  @@unique([eventId, orgId, billedCustomerId, metricId])
}

model RatingRetry {
  eventId String @id
  attempts Int @default(0)
  reason String @db.VarChar(32)
  failedAt DateTime @default(now()) @db.Timestamptz(3)
  retryAfter DateTime @db.Timestamptz(3)
  event UsageEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
}

model RatingFailure {
  eventId String @id
  orgId String
  metricId String
  priceVersionId String
  reason String @db.VarChar(32)
  failedAt DateTime @default(now()) @db.Timestamptz(3)
  event UsageEvent @relation(fields: [eventId, orgId, metricId], references: [id, orgId, metricId], onDelete: Restrict)
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  priceVersion PriceVersion @relation(fields: [priceVersionId, orgId, metricId], references: [id, orgId, metricId], onDelete: Restrict)

  @@unique([eventId, orgId, metricId])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  basePrice     Int
  billingPeriod BillingPeriod
  orgId         String
  createdAt     DateTime       @default(now())
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planMetrics   PlanMetric[]
  subscriptions Subscription[]
}

model PlanMetric {
  id            String   @id @default(uuid())
  includedUnits Int
  pricePerUnit  Int
  planId        String
  metricId      String
  createdAt     DateTime @default(now())
  metric        Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metricId])
}

model Subscription {
  id                 String             @id @default(uuid())
  status             SubscriptionStatus
  periodStart        DateTime
  periodEnd          DateTime?
  orgId              String
  planId             String
  externalCustomerId String?
  aggregatedUsages   AggregatedUsage[]
  invoices           Invoice[]
  org                Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  usageEvents        UsageEvent[]
}

model UsageEvent {
  id             String   @id @default(uuid())
  metricKey      String
  amount         Int
  customerId     String?
  billedCustomerId String?
  billingTreatment BillingTreatment @default(LEGACY)
  receivedAt     DateTime?
  processingState LedgerProcessingState?
  metadata       Json?
  timestamp      DateTime @default(now())
  orgId          String
  subscriptionId String
  apiKeyId       String
  idempotencyKey String?
  billableFingerprint String?
  metricId       String?
  createdAt      DateTime @default(now())
  metric         Metric?  @relation(fields: [metricId], references: [id], onDelete: SetNull)

  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billedCustomer Customer? @relation(fields: [orgId, billedCustomerId], references: [orgId, id], onDelete: Restrict)
  processingIntent LedgerProcessingIntent?
  ledgerProjection LedgerEventProjection?
  ratedEvent RatedEvent?
  ratingFailure RatingFailure?
  unratedEvent UnratedEvent?
  ratingRetry RatingRetry?

  @@index([orgId, subscriptionId, metricKey, timestamp])
  @@index([idempotencyKey])
  @@unique([orgId, idempotencyKey])
  @@unique([id, orgId, metricId])
  @@index([orgId, billedCustomerId])
  @@unique([id, orgId, billedCustomerId, metricId, amount])
  @@unique([id, orgId, billedCustomerId, metricId])
}

model LedgerProcessingIntent {
  eventId   String @id
  createdAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  attempts Int @default(0)
  failureReason String?
  event     UsageEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model LedgerEventProjection {
  eventId String @id
  orgId String
  billedCustomerId String
  metricKey String
  amount Int
  projectedAt DateTime @default(now())
  event UsageEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orgId, billedCustomerId, metricKey])
}

model LedgerExport {
  id          String @id @default(uuid())
  orgId       String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  totals      Json
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  rows        LedgerExportRow[]

  @@index([orgId, createdAt])
}

model LedgerExportRow {
  exportId           String
  position           Int
  eventId            String
  keyReference       String
  occurredAt         DateTime
  receivedAt         DateTime
  externalCustomerId String
  metric             String
  quantity           Int
  processingState    LedgerProcessingState
  failureReason      String?
  export             LedgerExport @relation(fields: [exportId], references: [id], onDelete: Restrict)

  @@id([exportId, position])
}

enum BillingTreatment {
  LEGACY
  LEDGER_ONLY
}

enum LedgerProcessingState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model AggregatedUsage {
  id             String       @id @default(uuid())
  metricKey      String
  total          Int
  periodStart    DateTime
  periodEnd      DateTime
  orgId          String
  subscriptionId String
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([orgId, subscriptionId, metricKey, periodStart])
  @@index([orgId, subscriptionId])
  @@index([orgId, metricKey])
}

model Invoice {
  id             String        @id @default(uuid())
  amount         Int
  status         InvoiceStatus
  periodStart    DateTime
  periodEnd      DateTime
  orgId          String
  subscriptionId String
  createdAt      DateTime      @default(now())
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lineItems      Json?

  @@index([orgId, createdAt])
  @@index([subscriptionId])
}

model BillingRecord {
  id String @id @default(uuid())
  orgId String
  billedCustomerId String
  periodStart DateTime @db.Timestamptz(3)
  periodEnd DateTime @db.Timestamptz(3)
  closeAt DateTime @db.Timestamptz(3)
  currentSnapshotId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [orgId, billedCustomerId], references: [orgId, id], onDelete: Restrict)
  snapshots BillingRecordSnapshot[] @relation("RecordSnapshots")
  currentSnapshot BillingRecordSnapshot? @relation("CurrentSnapshot", fields: [currentSnapshotId, id], references: [id, billingRecordId], onDelete: Restrict)

  @@unique([orgId, billedCustomerId, periodStart])
  @@unique([id, orgId, billedCustomerId])
}

model BillingRecordSnapshot {
  id String @id @default(uuid())
  billingRecordId String
  calculatedAt DateTime @db.Timestamptz(3)
  state BillingRecordState
  sourceEvents Json
  lines Json @default("[]")
  ratedSources Json @default("[]")
  eventOutcomes Json @default("[]")
  reconciliation Json @default("{}")
  lateArrivals Json @default("{}")
  record BillingRecord @relation("RecordSnapshots", fields: [billingRecordId], references: [id], onDelete: Restrict)
  currentFor BillingRecord[] @relation("CurrentSnapshot")

  @@unique([id, billingRecordId])
}

enum BillingRecordState {
  OPEN
  BLOCKED
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  url       String
  secret    String
  active    Boolean      @default(true)
  events    String[]
  orgId     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  webhookDeliveries WebhookDelivery[]
}

model AuditLog {
  id        String       @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  orgId     String
  userId    String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}

model WebhookEvent {
  id           String             @id @default(uuid())
  type         String
  payload      Json
  status       WebhookEventStatus @default(PENDING)
  targetEndpointIds String[]      @default([])
  orgId        String
  createdAt    DateTime           @default(now())
  deliveries   WebhookDelivery[]
  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookEventId String
  endpointId     String
  status         WebhookDeliveryStatus @default(PENDING)
  responseCode   Int?
  responseBody   String?
  attempt        Int                   @default(1)
  durationMs     Int?
  createdAt      DateTime              @default(now())

  webhookEvent WebhookEvent    @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEventId, endpointId, attempt])
}

model OrganizationInvite {
  id        String   @id @default(uuid())
  orgId     String
  email     String
  role      Role
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAUSED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}
